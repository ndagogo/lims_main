# =============================================================================
# LOCAL DEVELOPMENT ONLY
# Copy this file to backend/.env and fill in values:
#   copy .env.example .env   (PowerShell: Copy-Item .env.example .env)
# Never commit backend/.env. Railway secrets live in the Railway dashboard only.
# =============================================================================

# --- Required local ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=generate-a-unique-random-secret-for-local-development
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver,healthcheck.railway.app

# Leave empty for local SQLite (only when DJANGO_DEBUG=True).
# For local Postgres (docker-compose.dev.yml):
# DATABASE_URL=postgresql://hfdn_app:local-dev-change-me@127.0.0.1:5432/hfdn_health
DATABASE_URL=

MEDIA_ROOT=./media
SECURE_SSL_REDIRECT=false
LOG_LEVEL=INFO

# --- Auth / API ---
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
CSRF_TRUSTED_ORIGINS=http://localhost:3000
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCK_MINUTES=15

# --- Uploads ---
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false

# --- Notifications (local: log provider is enough) ---
NOTIFICATION_LOG_PROVIDER=true
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
WHATSAPP_PROVIDER_URL=
WHATSAPP_PROVIDER_TOKEN=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=results@hfdn.local
PATIENT_PORTAL_URL=https://www.example.com/patients
CRITICAL_ALERT_EMAIL=

# --- Optional private object storage (prefer for Railway multi-replica) ---
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
